{
    "code-runner.runInTerminal": true,
    "code-runner.saveFileBeforeRun": true,
    "terminal.integrated.defaultProfile.windows": "Command Prompt",
    "explorer.confirmDelete": false,
    "editor.fontFamily": "JetBrainsMono Nerd Font",
    "editor.fontSize": 16,
    "workbench.editor.empty.hint": "hidden",
    "livePreview.openPreviewTarget": "External Browser",
    "editor.mouseWheelZoom": true,
    "editor.defaultFormatter": "ms-python.black-formatter",
    "terminal.integrated.allowedLinkSchemes": [
        "file",
        "http",
        "https",
        "mailto",
        "vscode",
        "vscode-insiders",
        "ms-settings"
    ],
    "editor.cursorSmoothCaretAnimation": "on",
    "workbench.iconTheme": "material-icon-theme",
    "editor.fontLigatures": true,
    "vscode_vibrancy.disableFramelessWindow": true,
    "workbench.colorCustomizations": {
        "terminal.background": "#00000000",
        "autoDocstring.docstringFormat": "sphinx"
    
    },
    "terminal.integrated.gpuAcceleration": "off",
    "window.autoDetectColorScheme": false,
    "editor.lineHeight": 27,
    "workbench.productIconTheme": "fluent-icons",
    "workbench.colorTheme": "Dark Horizon",
    "workbench.sideBar.location": "right",
    "chat.disableAIFeatures": true,
    "autoDocstring.docstringFormat": "one-line-sphinx",
    "workbench.editorAssociations": {
        "*.zip": "default"
    },
    "[json]": {
        "editor.defaultFormatter": "vscode.json-language-features"
    },
    "clangd.path": "/home/akhil69/.config/VSCodium/User/globalStorage/llvm-vs-code-extensions.vscode-clangd/install/22.1.6/clangd_22.1.6/bin/clangd",
    "[c]": {
        "editor.defaultFormatter": "ms-vscode.cpptools"
    },
    "editor.minimap.enabled": false,
    "[html]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "explorer.fileNesting.patterns": {
        "*.ts": "${capture}.js",
        "*.js": "${capture}.js.map, ${capture}.min.js, ${capture}.d.ts",
        "*.jsx": "${capture}.js",
        "*.tsx": "${capture}.ts",
        "tsconfig.json": "tsconfig.*.json",
        "package.json": "package-lock.json, yarn.lock, pnpm-lock.yaml, bun.lockb, bun.lock",
        "*.sqlite": "${capture}.${extname}-*",
        "*.db": "${capture}.${extname}-*",
        "*.sqlite3": "${capture}.${extname}-*",
        "*.db3": "${capture}.${extname}-*",
        "*.sdb": "${capture}.${extname}-*",
        "*.s3db": "${capture}.${extname}-*"
    },
    "[sql]": {
        "editor.defaultFormatter": "mtxr.sqltools"
    },
    "sqltools.useNodeRuntime": true,
    "explorer.confirmDragAndDrop": false
    
}